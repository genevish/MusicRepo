[Unit]
Description=MusicRepo offline player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/MusicRepo
Environment=PATH=/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /home/pi/MusicRepo/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
